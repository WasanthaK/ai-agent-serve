OPENAI_API_KEY=your_openai_api_key_here
# Generate separate values with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Legacy single-channel inbound configuration (still supported):
AGENT_INBOUND_API_KEY=
AGENT_INBOUND_SOURCE=website
# Optional during the compatibility migration; required once tenant-owned
# request persistence is enabled.
# AGENT_INBOUND_TENANT_KEY=tenant-a
# Multi-channel Phase 4D configuration. Use this instead of the two legacy settings above.
# Example only; replace all keys with generated secrets and keep this value out of source control.
# The whatsapp credential is for trusted Quixo Messaging -> Agent forwarding, not Twilio itself.
# AGENT_INBOUND_CREDENTIALS=[{"source":"website","key":"...","tenant_key":"tenant-a"},{"source":"whatsapp","key":"...","tenant_key":"tenant-a"}]
# Operators may also carry an optional canonical tenant_key during migration.
# Example:
# AGENT_OPERATOR_CREDENTIALS=[{"id":"admin","key":"...","permissions":["read","decide"],"tenant_key":"tenant-a"}]
AGENT_OPERATOR_CREDENTIALS=
# SendGrid Inbound Parse signature-verification public key returned by the
# SendGrid webhook security-policy API. This is a public key, not an API key.
SENDGRID_INBOUND_PUBLIC_KEY=
# Maximum accepted HTTP request body in bytes. Default: 65536 (64 KiB).
# The current safety ceiling is 10485760 (10 MiB). SendGrid messages larger
# than the configured limit are intentionally rejected before parsing.
AGENT_MAX_REQUEST_BYTES=65536
# Authenticated request limits use rolling 60-second windows.
AGENT_INBOUND_RATE_LIMIT_PER_MINUTE=60
AGENT_OPERATOR_RATE_LIMIT_PER_MINUTE=120
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentdb
POSTGRES_USER=agentuser
