OPENAI_API_KEY=your_openai_api_key_here
# Generate separate values with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
AGENT_INBOUND_API_KEY=
AGENT_OPERATOR_CREDENTIALS=
AGENT_INBOUND_SOURCE=website
# Maximum accepted HTTP request body in bytes. Default: 65536 (64 KiB).
AGENT_MAX_REQUEST_BYTES=65536
# Authenticated request limits use rolling 60-second windows.
AGENT_INBOUND_RATE_LIMIT_PER_MINUTE=60
AGENT_OPERATOR_RATE_LIMIT_PER_MINUTE=120
POSTGRES_PASSWORD=your_strong_database_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agentdb
POSTGRES_USER=agentuser
